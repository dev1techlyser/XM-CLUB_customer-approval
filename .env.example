# Supabase Postgres (Session storage only)
# Database → Connection string → URI
# DATABASE_URL = Transaction pooler (port 6543) + ?pgbouncer=true
# DIRECT_URL   = Direct connection (port 5432) for prisma migrate
DATABASE_URL=
DIRECT_URL=

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_customers,read_metaobject_definitions,read_metaobjects,read_products,write_customers,write_metaobject_definitions,write_metaobjects,write_products
SHOPIFY_APP_URL=https://YOUR-PROJECT.vercel.app
