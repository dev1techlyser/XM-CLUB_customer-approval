# Supabase Postgres (Session storage only)
#
# IMPORTANT (Vercel / IPv4):
# Do NOT use db.<ref>.supabase.co for DIRECT_URL — that host is IPv6-first and
# Vercel builds often fail with P1001. Use the Pooler host for BOTH:
#
# DATABASE_URL = Transaction pooler (port 6543) + ?pgbouncer=true
#   postgresql://postgres.<ref>:<PASS>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# DIRECT_URL   = Session pooler (port 5432) — for prisma migrate
#   postgresql://postgres.<ref>:<PASS>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
DATABASE_URL=
DIRECT_URL=

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_customers,read_metaobject_definitions,read_metaobjects,read_products,write_customers,write_metaobject_definitions,write_metaobjects,write_products
SHOPIFY_APP_URL=https://xm-club-customer-approval.vercel.app
