// Session storage ONLY for Shopify OAuth tokens.
// Applications live in Shopify Metaobjects — do not add application models here.

generator client {
  provider      = "prisma-client-js"
  // native = local/Windows; rhel-openssl-3.0.x = Vercel Node serverless
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  // Supabase / Neon Postgres. Use pooled URL for DATABASE_URL; direct for migrations.
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
